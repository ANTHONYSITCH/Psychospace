import os
import pandas as pd
import numpy as np
import psycopg2
from datetime import datetime, timedelta


# ============================================================
# CONFIGURATION POSTGRESQL (depuis variables d'environnement)
# ============================================================

DB_CONFIG = {
    "host": os.getenv("DB_HOST", "localhost"),
    "port": int(os.getenv("DB_PORT", 5432)),
    "database": os.getenv("POSTGRES_DB", "astronaut_monitoring"),
    "user": os.getenv("POSTGRES_USER", "postgres"),
    "password": os.getenv("POSTGRES_PASSWORD", "postgres")
}


# ============================================================
# 1. GENERATION DES DONNEES BRUTES
# ============================================================

def generate_questionnaire_data():

    astronauts = [
        {
            "id": 1,
            "first_name": "Thomas",
            "last_name": "Bernard"
        },
        {
            "id": 2,
            "first_name": "Sarah",
            "last_name": "Martin"
        },
        {
            "id": 3,
            "first_name": "Alex",
            "last_name": "Dupont"
        }
    ]

    rows = []

    start_date = datetime(2026, 9, 1)

    for astronaut in astronauts:

        for day in range(7):

            date = start_date + timedelta(days=day)

            # ------------------------------------------------
            # Thomas : tendance à la fatigue
            # ------------------------------------------------

            if astronaut["id"] == 1:

                sleep = 7 - day * 0.3
                fatigue = 3 + day
                stress = 3 + day
                energy = 8 - day * 0.5
                mood = 8 - day * 0.3
                motivation = 8 - day * 0.2
                concentration = 8 - day * 0.4

            # ------------------------------------------------
            # Sarah : situation relativement stable
            # ------------------------------------------------

            elif astronaut["id"] == 2:

                sleep = 7
                fatigue = 3 + (day % 2)
                stress = 4
                energy = 7
                mood = 7
                motivation = 8
                concentration = 7

            # ------------------------------------------------
            # Alex : amélioration progressive
            # ------------------------------------------------

            else:

                sleep = 6 + day * 0.2
                fatigue = 7 - day * 0.5
                stress = 7 - day * 0.5
                energy = 4 + day * 0.5
                mood = 5 + day * 0.5
                motivation = 5 + day * 0.4
                concentration = 5 + day * 0.5

            rows.append({
                "astronaut_id": astronaut["id"],
                "checkin_date": date.date(),

                "sleep_duration_hours": round(sleep, 2),
                "sleep_quality": round(np.clip(7 - fatigue * 0.4, 0, 10)),

                "fatigue": round(np.clip(fatigue, 0, 10)),
                "energy": round(np.clip(energy, 0, 10)),
                "stress": round(np.clip(stress, 0, 10)),

                "stress_source": "workload",

                "mood": round(np.clip(mood, 0, 10)),
                "motivation": round(np.clip(motivation, 0, 10)),
                "concentration": round(np.clip(concentration, 0, 10)),

                "unusual_difficulty": "fatigue"
                if fatigue >= 7 else "none",

                "overall_state": round(
                    np.clip(
                        (
                            energy
                            + mood
                            + motivation
                            + concentration
                            + (10 - fatigue)
                            + (10 - stress)
                        ) / 6,
                        0,
                        10
                    )
                ),

                "compared_to_yesterday":
                    "worse" if day > 0 and fatigue > 5 else "stable",

                "comment":
                    "Difficulté à maintenir la concentration."
                    if concentration <= 5
                    else "État général satisfaisant."
            })

    return pd.DataFrame(rows)


# ============================================================
# 2. NETTOYAGE DES QUESTIONNAIRES
# ============================================================

def clean_questionnaire_data(df):

    print("\n[ETL] Nettoyage des questionnaires...")

    # --------------------------------------------------------
    # Suppression des doublons
    # --------------------------------------------------------

    df = df.drop_duplicates(
        subset=["astronaut_id", "checkin_date"]
    )

    # --------------------------------------------------------
    # Conversion des types
    # --------------------------------------------------------

    numeric_columns = [
        "sleep_duration_hours",
        "sleep_quality",
        "fatigue",
        "energy",
        "stress",
        "mood",
        "motivation",
        "concentration",
        "overall_state"
    ]

    for column in numeric_columns:
        df[column] = pd.to_numeric(
            df[column],
            errors="coerce"
        )

    # --------------------------------------------------------
    # Gestion des valeurs manquantes
    # --------------------------------------------------------

    for column in numeric_columns:

        if df[column].isna().any():

            median = df[column].median()

            df[column] = df[column].fillna(median)

    # --------------------------------------------------------
    # Limitation des valeurs 0-10
    # --------------------------------------------------------

    score_columns = [
        "sleep_quality",
        "fatigue",
        "energy",
        "stress",
        "mood",
        "motivation",
        "concentration",
        "overall_state"
    ]

    for column in score_columns:

        df[column] = df[column].clip(
            lower=0,
            upper=10
        )

    # --------------------------------------------------------
    # Durée du sommeil
    # --------------------------------------------------------

    df["sleep_duration_hours"] = df[
        "sleep_duration_hours"
    ].clip(
        lower=0,
        upper=24
    )

    # --------------------------------------------------------
    # Arrondi
    # --------------------------------------------------------

    df["sleep_duration_hours"] = df[
        "sleep_duration_hours"
    ].round(2)

    print(
        f"[ETL] {len(df)} questionnaires propres."
    )

    return df


