# ============================================================
# 4. NETTOYAGE DES CAPTEURS
# ============================================================

def clean_sensor_data(df):

    print("\n[ETL] Nettoyage des capteurs...")

    # Suppression doublons

    df = df.drop_duplicates(
        subset=["sensor_id", "recorded_at"]
    )

    # Conversion

    df["value"] = pd.to_numeric(
        df["value"],
        errors="coerce"
    )

    # Valeurs manquantes

    df["value"] = df["value"].fillna(
        df.groupby("sensor_id")["value"]
        .transform("median")
    )

    # --------------------------------------------------------
    # Contrôle des valeurs aberrantes par type de capteur
    # --------------------------------------------------------

    limits = {

        1: (15, 30),       # température

        2: (20, 80),       # humidité

        3: (300, 2000),    # CO2

        4: (900, 1100),    # pression

        5: (0, 20000),     # lumière

        6: (20, 100)       # bruit
    }

    cleaned_rows = []

    for _, row in df.iterrows():

        sensor_id = row["sensor_id"]

        minimum, maximum = limits[sensor_id]

        value = row["value"]

        if value < minimum or value > maximum:

            row["quality_status"] = "invalid"

        else:

            row["quality_status"] = "valid"

        cleaned_rows.append(row)

    df = pd.DataFrame(cleaned_rows)

    # On conserve les mesures mais on les marque.
    # Cela permet à l'IA de connaître la qualité des données.

    print(
        f"[ETL] {len(df)} mesures capteurs traitées."
    )

    return df


# ============================================================
# 5. CONNEXION POSTGRESQL
# ============================================================

def connect_database():

    return psycopg2.connect(
        **DB_CONFIG
    )


# ============================================================
# 6. INSERTION DES DONNEES
# ============================================================

def insert_data(
    questionnaire_df,
    sensor_df,
    sensors
):

    print("\n[ETL] Connexion PostgreSQL...")

    connection = connect_database()

    cursor = connection.cursor()

    try:

        # ----------------------------------------------------
        # Mission
        # ----------------------------------------------------

        cursor.execute(
            """
            INSERT INTO missions
            (
                name,
                description,
                start_date,
                status
            )
            VALUES
            (
                %s,
                %s,
                %s,
                %s
            )
            RETURNING id
            """,
            (
                "Mars Simulation Mission",
                "Simulation de surveillance quotidienne des astronautes.",
                "2026-09-01",
                "active"
            )
        )

        mission_id = cursor.fetchone()[0]

        print(
            f"[DB] Mission créée : {mission_id}"
        )

        # ----------------------------------------------------
        # Astronautes
        # ----------------------------------------------------

        astronaut_data = [

            (
                mission_id,
                "Thomas",
                "Bernard",
                "thomas@example.com",
                "DEMO_HASH_REPLACE_ME"
            ),

            (
                mission_id,
                "Sarah",
                "Martin",
                "sarah@example.com",
                "DEMO_HASH_REPLACE_ME"
            ),

            (
                mission_id,
                "Alex",
                "Dupont",
                "alex@example.com",
                "DEMO_HASH_REPLACE_ME"
            )
        ]

        astronaut_ids = {}

        for astronaut in astronaut_data:

            cursor.execute(
                """
                INSERT INTO astronauts
                (
                    mission_id,
                    first_name,
                    last_name,
                    email,
                    password_hash
                )
                VALUES
                (%s, %s, %s, %s, %s)
                RETURNING id
                """,
                astronaut
            )

            database_id = cursor.fetchone()[0]

            astronaut_ids[
                astronaut[1]
            ] = database_id

        print("[DB] Astronautes créés.")

        # ----------------------------------------------------
        # Questionnaires
        # ----------------------------------------------------

        for _, row in questionnaire_df.iterrows():

            cursor.execute(
                """
                INSERT INTO daily_checkins
                (
                    astronaut_id,
                    checkin_date,
                    sleep_duration_hours,
                    sleep_quality,
                    fatigue,
                    energy,
                    stress,
                    stress_source,
                    mood,
                    motivation,
                    concentration,
                    unusual_difficulty,
                    overall_state,
                    compared_to_yesterday,
                    comment
                )
                VALUES
                (
                    %s, %s, %s, %s, %s,
                    %s, %s, %s, %s, %s,
                    %s, %s, %s, %s, %s
                )
                """,
                (
                    row["astronaut_id"],
                    row["checkin_date"],
                    row["sleep_duration_hours"],
                    row["sleep_quality"],
                    row["fatigue"],
                    row["energy"],
                    row["stress"],
                    row["stress_source"],
                    row["mood"],
                    row["motivation"],
                    row["concentration"],
                    row["unusual_difficulty"],
                    row["overall_state"],
                    row["compared_to_yesterday"],
                    row["comment"]
                )
            )

        print("[DB] Questionnaires insérés.")

        # ----------------------------------------------------
        # Capteurs
        # ----------------------------------------------------

        sensor_db_ids = {}

        for sensor in sensors:

            cursor.execute(
                """
                INSERT INTO sensors
                (
                    mission_id,
                    sensor_name,
                    sensor_type,
                    location,
                    unit
                )
                VALUES
                (%s, %s, %s, %s, %s)
                RETURNING id
                """,
                (
                    mission_id,
                    sensor["name"],
                    sensor["type"],
                    sensor["location"],
                    sensor["unit"]
                )
            )

            db_id = cursor.fetchone()[0]

            sensor_db_ids[
                sensor["id"]
            ] = db_id

        # ----------------------------------------------------
        # Mesures capteurs
        # ----------------------------------------------------

        for _, row in sensor_df.iterrows():

            cursor.execute(
                """
                INSERT INTO sensor_readings
                (
                    sensor_id,
                    recorded_at,
                    value,
                    quality_status
                )
                VALUES
                (%s, %s, %s, %s)
                """,
                (
                    sensor_db_ids[row["sensor_id"]],
                    row["recorded_at"],
                    row["value"],
                    row["quality_status"]
                )
            )

        print("[DB] Mesures capteurs insérées.")

        # ----------------------------------------------------
        # Validation finale
        # ----------------------------------------------------

        connection.commit()

        print("\n====================================")
        print("PIPELINE ETL TERMINE")
        print("====================================")

    except Exception as error:

        connection.rollback()

        print(
            "\n[ERREUR] Rollback effectué."
        )

        print(error)

        raise

    finally:

        cursor.close()
        connection.close()


# ============================================================
# 7. MAIN
# ============================================================

def main():

    print("====================================")
    print("ASTRONAUT MONITORING ETL")
    print("====================================")

    # Questionnaire

    questionnaire = generate_questionnaire_data()

    questionnaire = clean_questionnaire_data(
        questionnaire
    )

    # Capteurs

    sensor_data, sensors = generate_sensor_data()

    sensor_data = clean_sensor_data(
        sensor_data
    )

    # PostgreSQL

    insert_data(
        questionnaire,
        sensor_data,
        sensors
    )


if __name__ == "__main__":
    main()